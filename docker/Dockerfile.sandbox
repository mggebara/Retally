# retally-sandbox
#
# Offline execution environment for ML paper reproduction code.
# This image is intentionally lean: no pip cache, no dev tools, non-root user.
#
# Build:
#   docker build -f docker/Dockerfile.sandbox -t retally-sandbox:latest docker/
#
# The container is always started with --network none so generated code cannot
# make outbound connections.  The dataset is mounted read-only at its host path
# and the generated script is mounted at /workspace/script.py.

FROM python:3.11-slim

# ── system deps ───────────────────────────────────────────────────────────────
# libgomp1 is required by XGBoost / LightGBM for OpenMP parallelism.
RUN apt-get update && apt-get install -y --no-install-recommends \
        libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# ── Python packages ───────────────────────────────────────────────────────────
COPY requirements.sandbox.txt /tmp/requirements.sandbox.txt
RUN pip install --no-cache-dir -r /tmp/requirements.sandbox.txt \
    && rm /tmp/requirements.sandbox.txt

# ── sandbox user (non-root) ───────────────────────────────────────────────────
RUN groupadd -r sandbox && useradd -r -g sandbox -d /workspace -s /bin/false sandbox
RUN mkdir -p /workspace && chown sandbox:sandbox /workspace

WORKDIR /workspace
USER sandbox

# Generated script is always mounted at this path by DockerExecutor.
CMD ["python", "-u", "/workspace/script.py"]
