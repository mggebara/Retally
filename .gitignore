__pycache__/
*.pyc
*.pyo
.cache/
*.egg-info/
dist/
build/
.pytest_cache/
.ruff_cache/
.mypy_cache/
# uv-managed project venv — recreated by ``uv sync``.
.venv/

# Benchmark build artefacts.  Catalog YAMLs under benchmark/papers/ are
# committed when they exist (the directory is empty until real I4R entries
# land — placeholders live under tests/fixtures/benchmark_placeholders/).
# REPORT.md is committed; results.json, report.html, and the cache are
# rebuildable from the catalog.
benchmark/.cache/
benchmark/results/results.json
benchmark/results/report.html
# Staging area for the claim-pinning workflow: raw extractor output a
# human reviews before curating it into a catalog entry's original_claims.
benchmark/results/extracted_claims/
# Per-run artifacts (generated scripts, sandbox output, prompts): large,
# per-run, and may contain data excerpts.  See benchmark/README.md.
benchmark/results/artifacts/
# Claude Code reproductions (``--reproducer claude-code``): scripts, sandbox
# output and reproduction.json a session wrote per cell, under
# benchmark/reproductions/<entry>/<mode>/<run_id>/.  Per-run and may contain
# data excerpts, like the artifacts; the scored copy lands in artifacts/.
benchmark/reproductions/
# Auto-generated candidate YAMLs from scripts/import_i4r_candidates.py.
# Rebuildable from benchmark/corpus/; a human promotes the good ones into
# benchmark/papers/ (which IS committed), so the staging dir stays untracked.
benchmark/candidates/
# Claude Code agent worktrees (show up as untracked otherwise).
.claude/worktrees/
